{
  "name": "techgig-radar",
  "version": "1.0.0",
  "description": "Real Tech News. Real Global Opportunities. - Automated technology news and job opportunity discovery platform.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "tsx src/dashboard/server.ts",
    "start:auto": "tsx src/auto-runner.ts",
    "start:prod": "node --loader tsx src/server-with-auto.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest",
    "cli": "tsx src/cli/index.ts",
    "discover:news": "tsx src/cli/index.ts discover news",
    "discover:jobs": "tsx src/cli/index.ts discover jobs",
    "dashboard": "tsx src/cli/index.ts dashboard"
  },
  "keywords": [
    "tech-news",
    "job-discovery",
    "telegram-bot",
    "instagram",
    "automation",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@bull-board/api": "^6.4.2",
    "@bull-board/fastify": "^6.4.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.25.6",
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "express": "^5.2.1",
    "fastify": "^5.1.0",
    "grammy": "^1.30.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.9",
    "node-html-to-image": "^5.0.0",
    "openai": "^4.77.0",
    "p-limit": "^6.1.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.33.5",
    "string-similarity-js": "^2.1.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
