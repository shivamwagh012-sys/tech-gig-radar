# ================================
# TechGig Radar - Environment Configuration
# ================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# ================================
# Database
# ================================
DATABASE_URL=postgresql://user:password@localhost:5432/techgig_radar
REDIS_URL=redis://localhost:6379

# ================================
# AI APIs (choose one or both)
# ================================
# OpenAI API key for content generation
OPENAI_API_KEY=sk-...

# Anthropic API key (alternative)
ANTHROPIC_API_KEY=sk-ant-...

# Preferred AI provider: openai or anthropic
AI_PROVIDER=openai

# ================================
# Telegram Configuration
# ================================
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=8975240386:AAHhAHZu-fzZ-eSIYqRJI47Yi5EBa_QjOtY

# Channel ID or username where content will be published
# Can be @channelname or numeric ID like -1001234567890
TELEGRAM_CHANNEL_ID=@TechGigRadar

# Admin chat ID for notifications (your personal Telegram ID)
TELEGRAM_ADMIN_CHAT_ID=973753880

# ================================
# Instagram / Meta Configuration
# ================================
# Instagram Business Account ID
INSTAGRAM_BUSINESS_ACCOUNT_ID=techgigradar

# Long-lived access token from Meta Graph API
INSTAGRAM_ACCESS_TOKEN=

# Facebook Page ID connected to Instagram account
FACEBOOK_PAGE_ID=Techgigradar

# ================================
# Application Settings
# ================================
NODE_ENV=development
PORT=3000
HOST=localhost

# Secret for admin API authentication
ADMIN_SECRET=your-secure-admin-secret-here

# JWT secret for dashboard authentication
JWT_SECRET=your-secure-jwt-secret-here

# ================================
# Discovery Settings
# ================================
# How often to check for new content (in minutes)
NEWS_CHECK_INTERVAL_MINUTES=30
JOBS_CHECK_INTERVAL_MINUTES=120

# Maximum posts per day per platform
MAX_NEWS_PER_DAY=10
MAX_JOBS_PER_DAY=5

# ================================
# Verification Settings
# ================================
# Minimum score (0-100) to be eligible for publishing
MIN_VERIFICATION_SCORE=60

# Minimum score for auto-approval (if enabled)
AUTO_APPROVE_THRESHOLD=80

# ================================
# Feature Flags
# ================================
# Set to true to enable automatic publishing without review
AUTO_PUBLISH_ENABLED=false

# Set to true to require human approval for all content
REQUIRE_HUMAN_APPROVAL=true

# Enable/disable specific platforms
TELEGRAM_ENABLED=true
INSTAGRAM_ENABLED=false

# ================================
# Content Settings
# ================================
# Maximum age of news to consider (in hours)
MAX_NEWS_AGE_HOURS=72

# Maximum age of job postings to consider (in days)
MAX_JOB_AGE_DAYS=30

# ================================
# Logging
# ================================
LOG_LEVEL=info

# ================================
# Optional: External Services
# ================================
# Sentry DSN for error tracking
SENTRY_DSN=

# Webhook URL for admin notifications (Slack, Discord, etc.)
ADMIN_WEBHOOK_URL=
